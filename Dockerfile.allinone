# All-in-one image: web (Next.js) + worker (BullMQ) + browser connector (Playwright) in
# one container, for hosts where one service is easiest (e.g. Easypanel).
# Needs only DATABASE_URL, REDIS_URL and the usual app secrets; the browser service listens
# on 127.0.0.1:8000 inside the container and is never exposed.

# Builder is glibc-based so native modules (argon2, Prisma engine) match the Ubuntu runtime.
FROM node:20-bookworm-slim AS node
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*

FROM node AS dependencies
WORKDIR /app
COPY package.json package-lock.json ./
COPY prisma ./prisma
RUN npm ci

FROM node AS builder
WORKDIR /app
COPY --from=dependencies /app/node_modules ./node_modules
COPY . .
ENV NEXT_TELEMETRY_DISABLED=1
RUN npx prisma generate && npm run build && npm prune --omit=dev && rm -rf .next/cache

# Runtime: Playwright's Ubuntu image (Chromium + deps + Xvfb + Python 3.12) plus Node 20.
FROM mcr.microsoft.com/playwright/python:v1.64.1-noble AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends tini openssl && rm -rf /var/lib/apt/lists/*
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
 && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
 && node -v && npm -v

# Browser connector service.
COPY services/browser/requirements.txt /opt/browser/requirements.txt
RUN pip install --no-cache-dir -r /opt/browser/requirements.txt
# Every module of the service (app imports blinkit_search / blinkit_seller_seo lazily, so a missing
# file only shows up as a failed sync, never at start-up).
COPY --chmod=644 services/browser/*.py /opt/browser/
RUN cd /opt/browser && python -c "import platforms, blinkit_ads, blinkit_ads_bids, blinkit_search, blinkit_seller_seo"

# App (web + worker).
WORKDIR /app
COPY --from=builder --chown=pwuser:pwuser /app/package.json /app/package-lock.json ./
COPY --from=builder --chown=pwuser:pwuser /app/node_modules ./node_modules
COPY --from=builder --chown=pwuser:pwuser /app/.next ./.next
COPY --from=builder --chown=pwuser:pwuser /app/public ./public
COPY --from=builder --chown=pwuser:pwuser /app/prisma ./prisma
COPY --from=builder --chown=pwuser:pwuser /app/lib ./lib
COPY --from=builder --chown=pwuser:pwuser /app/worker ./worker
COPY --from=builder --chown=pwuser:pwuser /app/packages ./packages
COPY --from=builder --chown=pwuser:pwuser /app/scripts ./scripts
COPY --from=builder --chown=pwuser:pwuser /app/tsconfig.json /app/next.config.mjs ./
COPY --chmod=755 docker-allinone-start.sh /usr/local/bin/qcp-start
RUN mkdir -p /app/.import-staging /data/profiles && chown -R pwuser:pwuser /app/.import-staging /data

ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PYTHONUNBUFFERED=1 \
    PROFILE_DIR=/data/profiles BROWSER_SERVICE_URL=http://127.0.0.1:8000
# Persist these two: uploaded imports awaiting processing, and seller-panel login sessions.
VOLUME ["/app/.import-staging", "/data/profiles"]
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3000/api/health/live').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/qcp-start"]
