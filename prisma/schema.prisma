  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  brand    Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  platform Platform     @relation(fields: [platformId], references: [id])

  @@unique([brandId, platformId, orderId, itemId])
  @@index([orgId, orderDate])
  @@index([brandId, platformId, orderDate])
}

// Stock on hand per item × warehouse, one snapshot per sync day (seller-panel inventory export).
model ChannelInventory {
  id                BigInt   @id @default(autoincrement())
  orgId             BigInt
  brandId           BigInt
  platformId        Int
  skuId             BigInt?
  snapshotDate      DateTime @db.Date
  itemId            String
  itemName          String
  upc               String?
  uom               String?
  warehouseId       String
  warehouseName     String
  city              String
  netScheduled      Int      @default(0)
  incomingScheduled Int      @default(0)
  recalled          Int      @default(0)
  totalSellable     Int      @default(0)
  warehouseUnits    Int      @default(0)
  inBetweenUnits    Int      @default(0)
  darkstoreUnits    Int      @default(0)
  totalUnsellable   Int      @default(0)
  damaged           Int      @default(0)
  lost              Int      @default(0)
  expired           Int      @default(0)
  nearExpiry        Int      @default(0)
  sold7d            Int      @default(0)
  sold15d           Int      @default(0)
  sold30d           Int      @default(0)
