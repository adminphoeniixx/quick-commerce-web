  @@index([orgId, snapshotDate])
  @@index([brandId, platformId, snapshotDate])
}

// ── Blinkit Ads (brands.blinkit.com) ─────────────────────────────────────────────
// Synced from the brand's own ad account by the browser connector (platform "blinkit-ads").
// Money is INR as reported by the portal. ROAS is always derived (sales / spend).

// Ad account state per sync day: wallet, credit, festive insights, collections.
model AdAccountSnapshot {
  id             BigInt   @id @default(autoincrement())
  orgId          BigInt
  brandId        BigInt
  platformId     Int
  snapshotDate   DateTime @db.Date
  advertiserId   String
  advertiserName String?
  status         String?
  walletBalance  Decimal? @db.Decimal(14, 2)
  tentativeSpend Decimal? @db.Decimal(14, 2)
  creditBalance  Decimal? @db.Decimal(14, 2)
  festive        Json? // { summary, keywords }
  collections    Json?
  details        Json // advertiser features, plans, region-id → city map
  updatedAt      DateTime @updatedAt

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  brand    Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  platform Platform     @relation(fields: [platformId], references: [id])

  @@unique([brandId, platformId, snapshotDate])
  @@index([orgId])
}

// One ad campaign with its current settings and lifetime totals.
model AdCampaign {
  id                  BigInt    @id @default(autoincrement())
  orgId               BigInt
  brandId             BigInt
  platformId          Int
  campaignId          String
  name                String
  campaignType        String // PRODUCT_LISTING | PRODUCT_RECOMMENDATION | BANNER_LISTING | …
  objective           String?
  status              String // ACTIVE | STOPPED | COMPLETED | …
  startAt             DateTime?
  endAt               DateTime? // null = runs until stopped
  budget              Decimal?  @db.Decimal(14, 2)
  pacing              String?
  regionType          String?
  cities              String[]
  productIds          String[] // Blinkit product ids; join ChannelProduct.productId
  keywords            Json? // targeted keywords with bids
  lifetimeSpend       Decimal?  @db.Decimal(14, 2)
  lifetimeImpressions BigInt?
  lifetimeSales       Decimal?  @db.Decimal(14, 2)
  lifetimeAtc         Int?
  details             Json
  updatedAt           DateTime  @updatedAt

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  brand    Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  platform Platform     @relation(fields: [platformId], references: [id])

  @@unique([brandId, platformId, campaignId])
  @@index([orgId])
}

// Campaign × IST day performance (grain: campaign × date).
model AdCampaignDaily {
  id            BigInt   @id @default(autoincrement())
  orgId         BigInt
  brandId       BigInt
  platformId    Int
  campaignId    String
  date          DateTime @db.Date
  spend         Decimal  @default(0) @db.Decimal(14, 2)
  impressions   Int      @default(0)
  ctr           Decimal? @db.Decimal(8, 4)
  directAtc     Int      @default(0)
  indirectAtc   Int      @default(0)
  totalAtc      Int      @default(0)
  directSales   Decimal  @default(0) @db.Decimal(14, 2)
  indirectSales Decimal  @default(0) @db.Decimal(14, 2)
  totalSales    Decimal  @default(0) @db.Decimal(14, 2)
  directQty     Int      @default(0)
  indirectQty   Int      @default(0)
  totalQty      Int      @default(0)
  newUsers      Int      @default(0)
  updatedAt     DateTime @updatedAt

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  brand    Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  platform Platform     @relation(fields: [platformId], references: [id])

  @@unique([brandId, platformId, campaignId, date])
  @@index([orgId, date])
  @@index([brandId, platformId, date])
}

// Campaign × day × keyword (or another portal breakdown) performance.
model AdKeywordDaily {
  id            BigInt   @id @default(autoincrement())
  orgId         BigInt
  brandId       BigInt
  platformId    Int
  campaignId    String
  date          DateTime @db.Date
  dimension     String // "keyword" today; other portal breakdowns keep their name
  dimKey        String
  label         String
  matchType     String?
  impressions   Int      @default(0)
  spend         Decimal  @default(0) @db.Decimal(14, 2)
  directAtc     Int      @default(0)
  indirectAtc   Int      @default(0)
  directSales   Decimal  @default(0) @db.Decimal(14, 2)
  indirectSales Decimal  @default(0) @db.Decimal(14, 2)
  directQty     Int      @default(0)
  indirectQty   Int      @default(0)
  newUsers      Int      @default(0)
  position      Int? // most viewed slot position
  updatedAt     DateTime @updatedAt

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  brand    Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  platform Platform     @relation(fields: [platformId], references: [id])

  @@unique([brandId, platformId, campaignId, date, dimension, dimKey])
  @@index([brandId, platformId, date])
}

// ── Blinkit Seller Hub listing / SEO (seller.blinkit.com) ────────────────────────────────
// One row per product per sync day, from the seller's own catalogue + expansion + sales pages
// (agent MCP blinkit_seller_seo_sync). Metrics are as reported by the portal.
model ListingSeoSnapshot {
  id                 BigInt    @id @default(autoincrement())
  orgId              BigInt
  brandId            BigInt
  platformId         Int
  snapshotDate       DateTime  @db.Date
  productId          String // Blinkit product id; joins ChannelProduct.productId, AdCampaign.productIds
  itemId             String?
  name               String
  brandName          String?
  category           String? // primary consumer category, e.g. "Almonds"
  unit               String?
  expansionLevel     String? // Trial | L1..L4
  availabilityPct    Float?
  availabilityTarget Float?
  unitsPerStoreDay   Float? // portal "CPD"
  unitsTarget        Float?
  salesPerStoreDay   Float?
  salesTarget        Float?
  complaintPct       Float?
  storesLive         Int?
  storesNew          Int?
  storesClosed       Int?
  citiesLive         Int?
  citiesNew          Int?
  citiesClosed       Int?
  assessmentEnd      DateTime?
  periodLabel        String? // sales window, e.g. "Last 30 days"
  units              Int?
  sales              Float?
  salesSharePct      Float?
  complaints         Int?
  titleLength        Int       @default(0)
  descriptionLength  Int       @default(0)
  imageCount         Int       @default(0)
  attrsFilled        Int       @default(0)
  attrsTotal         Int       @default(0)
  engagementScore    Float? // portal's internal product_engagement_score attribute
  missingAttributes  Json // [{ name, group, mandatory }]
  cities             Json // per-city breakdown from the expansion page
  content            Json // title, description, key attributes, image urls
  issues             Json // [{ severity, code, message }]
  updatedAt          DateTime  @updatedAt

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  brand    Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  platform Platform     @relation(fields: [platformId], references: [id])

  @@unique([brandId, platformId, snapshotDate, productId], map: "ListingSeoSnapshot_brand_platform_date_product_key")
  @@index([orgId])
}

// One product card on a blinkit.com search results page (agent MCP blinkit_keyword_rank), read in
// the user's own Chrome for keywords taken from Blinkit Ads. Grain: keyword × city × day × product.
model SearchListingObservation {
  id           BigInt   @id @default(autoincrement())
  orgId        BigInt
  brandId      BigInt
  platformId   Int
  snapshotDate DateTime @db.Date
  keyword      String
  city         String
  location     String? // delivery address shown in the page header
  rank         Int // position among all cards
  organicRank  Int? // position among non-ad cards; null for ads
  productId    String
  name         String
  brandName    String?
  pack         String?
  rating       Float?
  ratingCount  Int?
  price        Float?
  mrp          Float?
  isAd         Boolean  @default(false)
  adCampaignId String?
  inventory    Int?
  soldOut      Boolean  @default(false)
  isOwn        Boolean  @default(false)
  observedAt   DateTime

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  brand    Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  platform Platform     @relation(fields: [platformId], references: [id])

  @@unique([brandId, platformId, snapshotDate, keyword, city, productId], map: "SearchListingObservation_brand_day_kw_city_product_key")
  @@index([brandId, snapshotDate])
}

// Blinkit Ads keyword bid change: proposed in QCP, approved by the seller (OWNER/ORG_ADMIN), then
// applied by the server's Blinkit Ads browser session (services/browser/blinkit_ads_bids.py).
// status: PENDING → APPROVED → APPLYING → APPLIED | CONFLICT | FAILED; or REJECTED / CANCELLED.
model AdBidChange {
  id            BigInt    @id @default(autoincrement())
  orgId         BigInt
  brandId       BigInt
  platformId    Int // blinkit-ads
  campaignId    String
  campaignName  String
  keyword       String
  matchType     String // EXACT | SMART
  fromCpm       Decimal?  @db.Decimal(10, 2) // QCP's last synced bid when proposed
  toCpm         Decimal   @db.Decimal(10, 2)
  status        String    @default("PENDING")
  note          String?
  evidence      Json? // immutable metrics and agent decision behind an AI recommendation
  dataAsOf      DateTime? @db.Date
  model         String?
  promptVersion String?
  growthPlanId  BigInt? // SalesGrowthPlan that drafted this change, if any
  createdBy     String // email
  decidedBy     String? // email of approver / rejecter
  decidedAt     DateTime?
  appliedAt     DateTime?
  beforeCpm     Decimal?  @db.Decimal(10, 2) // what Blinkit showed right before applying
  afterCpm      Decimal?  @db.Decimal(10, 2) // what Blinkit showed after applying (verified)
  error         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  brand    Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  platform Platform     @relation(fields: [platformId], references: [id])

  @@index([brandId, platformId, status])
  @@index([brandId, platformId, campaignId])
  @@index([growthPlanId])
}

// Durable, idempotent human approval record for an AI-assisted campaign launch.
model AdCampaignProposal {
  id                 BigInt    @id @default(autoincrement())
  orgId              BigInt
  brandId            BigInt
  platformId         Int
  templateCampaignId String
  name               String
  budget             Decimal   @db.Decimal(14, 2)
  startAt            DateTime  @db.Date
  endAt              DateTime  @db.Date
  status             String    @default("PENDING_APPROVAL")
  evidence           Json
  forecast           Json
  agentReviews       Json
  dataAsOf           DateTime  @db.Date
  model              String?
  promptVersion      String
  idempotencyKey     String
  payloadHash        String
  createdBy          String
  decidedBy          String?
  decidedAt          DateTime?
  remoteCampaignId   String?
  error              String?
  growthPlanId       BigInt?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  brand    Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  platform Platform     @relation(fields: [platformId], references: [id])

  @@index([growthPlanId])
  @@unique([orgId, idempotencyKey])
  @@index([brandId, platformId, status])
  @@index([templateCampaignId])
}

// Seller-owned objective used by the sales-growth orchestration graph.
model SalesGrowthGoal {
  id                   BigInt   @id @default(autoincrement())
  orgId                BigInt
  brandId              BigInt
  targetSalesGrowthPct Decimal  @db.Decimal(6, 2)
  maxDailyAdSpend      Decimal  @db.Decimal(14, 2)
  minimumRoas          Decimal  @db.Decimal(8, 3)
  horizonDays          Int
  active               Boolean  @default(true)
  // Autopilot: the worker re-researches a fresh plan on this cadence. Execution still needs human approval.
  autopilot            Boolean  @default(false)
  replanEveryDays      Int      @default(7)
  notifyEmail          String?
  createdBy            String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([orgId, brandId, active])
  @@index([active, autopilot])
}

// Researched plan. Lifecycle: QUEUED → RESEARCHING → DRAFT | FAILED → APPROVED | REJECTED | EXPIRED | SUPERSEDED
// → MATERIALIZED → COMPLETED. The research snapshot (baseline/forecast/actions) is immutable once DRAFT.
model SalesGrowthPlan {
  id             BigInt    @id @default(autoincrement())
  orgId          BigInt
  brandId        BigInt
  goalId         BigInt
  status         String    @default("QUEUED")
  trigger        String    @default("manual") // manual | autopilot
  baseline       Json?
  forecast       Json?
  actions        Json?
  agentReviews   Json?
  dataAsOf       DateTime? @db.Date
  model          String?
  promptVersion  String
  payloadHash    String?
  error          String?
  attempts       Int       @default(0)
  createdBy      String
  startedAt      DateTime?
  finishedAt     DateTime?
  approvedBy     String?
  approvedAt     DateTime?
  materializedAt DateTime?
  measuredAt     DateTime?
  completedAt    DateTime?
  outcome        Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  planActions SalesGrowthAction[]

  @@unique([orgId, payloadHash])
  @@index([brandId, status, createdAt])
  @@index([status, materializedAt])
  @@index([goalId])
}

// One mutable execution record per researched action. Status: PROPOSED → APPROVED | REJECTED → DRAFTED
// → LIVE | FAILED | DISCARDED. BLOCKED = failed revalidation when drafts were created.
model SalesGrowthAction {
  id                 BigInt    @id @default(autoincrement())
  planId             BigInt
  orgId              BigInt
  brandId            BigInt
  actionKey          String
  type               String // BID | CAMPAIGN
  priority           Int
  title              String
  campaignId         String?
  keyword            String?
  matchType          String?
  payload            Json
  forecastSalesDelta Json
  status             String    @default("PROPOSED")
  bidChangeId        BigInt?
  campaignProposalId BigInt?
  remoteCampaignId   String?
  error              String?
  decidedBy          String?
  decidedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  plan SalesGrowthPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, actionKey])
  @@index([brandId, status])
}

// Learning memory: what a LIVE growth action actually achieved once its plan completed.
model GrowthActionOutcome {
  id               BigInt   @id @default(autoincrement())
  orgId            BigInt
  brandId          BigInt
  planId           BigInt? // null for HISTORICAL events
  actionKey        String
  source           String   @default("PLAN") // PLAN | HISTORICAL
  eventKey         String? // HISTORICAL: stable id of the detected event
  type             String // BID | CAMPAIGN
  direction        String // increase | decrease | launch
  campaignId       String?
  keyword          String?
  matchType        String?
  changePct        Float?
  forecastLow      Float
  forecastHigh     Float
  beforeSales      Float
  beforeSpend      Float
  afterSales       Float
  afterSpend       Float
  controlGrowthPct Float?
  salesDelta       Float // lift-adjusted: after − before × (1 + control growth)
  forecastRatio    Float? // salesDelta / forecast reference; null when the forecast reference is ~0
  measuredFrom     DateTime @db.Date
  measuredTo       DateTime @db.Date
  createdAt        DateTime @default(now())

  @@unique([planId, actionKey])
  @@unique([brandId, eventKey])
  @@index([brandId, type, direction, createdAt])
  @@index([brandId, campaignId, keyword])
}

// Forecast correction learned from outcomes, per brand × action type × direction.
model GrowthCalibration {
  id         BigInt   @id @default(autoincrement())
  orgId      BigInt
  brandId    BigInt
  type       String
  direction  String
  sampleSize Int
  rawRatio   Float
  factor     Float
  updatedAt  DateTime @updatedAt

  @@unique([brandId, type, direction])
}

// Learned from blinkit.com search history × keyword sales: how sales respond to rank, price gap and competitor stock-outs.
// Correlational evidence for the agents only; never a gate.
model KeywordMarketInsight {
  id                  BigInt   @id @default(autoincrement())
  orgId               BigInt
  brandId             BigInt
  keyword             String // lower-case
  sampleDays          Int
  meanDailySales      Float
  avgOrganicRank      Float?
  rankSensitivityPct  Float? // % change in daily keyword sales per 1 position worse organic rank
  avgPriceGapPct      Float? // own price vs competitor median, %
  priceSensitivityPct Float? // % change in daily keyword sales per +1 pt price gap
  stockoutUpliftPct   Float? // sales lift on days ≥20% of competitors in the top 10 are sold out
  adShareTop10        Float? // share of ad cards in the top 10 results
  confidence          String // insufficient | low | medium | high
  updatedAt           DateTime @updatedAt

  @@unique([brandId, keyword])
}

// Human-approved change to an existing Blinkit Ads campaign (budget update, restart, stop).
// PENDING → APPROVED → APPLYING → APPLIED | FAILED; or REJECTED. Applied with an expected-status/budget check.
model AdCampaignChange {
  id             BigInt    @id @default(autoincrement())
  orgId          BigInt
  brandId        BigInt
  platformId     Int
  campaignId     String
  campaignName   String
  kind           String // update | restart | stop
  expectedStatus String
  expectedBudget Decimal?  @db.Decimal(14, 2)
  toBudget       Decimal?  @db.Decimal(14, 2)
  status         String    @default("PENDING")
  reason         String
  evidence       Json
  growthPlanId   BigInt?
  createdBy      String
  decidedBy      String?
  decidedAt      DateTime?
  appliedAt      DateTime?
  error          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([brandId, platformId, status])
  @@index([growthPlanId])
}
